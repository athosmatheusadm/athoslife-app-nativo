<?xml version="1.0" encoding="utf-8"?>
<!--
  Live Activity do treino, expandida — athoslife-live-activity-mockup.html (22/10).
  Só views aceitas por RemoteViews. Um bloco por formato (série com reps,
  série por tempo, descanso); LiveActivityNotificacao liga um e esconde os outros.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/la_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/athos_la_card"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- cabeçalho: miniatura, nome + série + segmentos, chip de status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/la_thumb"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/athos_la_thumb_lima">

            <ImageView
                android:id="@+id/la_icone"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/athos_la_ic_halter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/la_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/athos_la_texto"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/la_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/athos_la_texto_baixo"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/la_segs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <ImageView
                    android:id="@+id/la_seg1"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg2"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg3"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg4"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg5"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg6"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg7"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/la_seg8"
                    android:layout_width="12dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/athos_la_seg_vazio"
                    android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la_chip"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/athos_la_chip_lima"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/la_chip_ponto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="●"
                android:textColor="@color/athos_la_lima"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/la_chip_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/athos_la_lima"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- formato 1: série com carga e reps -->
    <LinearLayout
        android:id="@+id/la_bloco_reps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/athos_la_stp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/la_rot_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/athos_la_texto_baixo"
                android:textSize="11sp" />

            <!-- número numa linha só dele: dentro da moldura do Android 12+
                 o espaço entre − e + não cabia "80 kg" (dono, 30/10) -->
            <TextView
                android:id="@+id/la_valor_a"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="5dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="15sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/athos_la_texto"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/la_a_menos"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/athos_la_pilula"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/la_a_mais"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/athos_la_pilula"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/athos_la_stp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/la_rot_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/athos_la_texto_baixo"
                android:textSize="11sp" />

            <!-- número numa linha só dele: dentro da moldura do Android 12+
                 o espaço entre − e + não cabia "80 kg" (dono, 30/10) -->
            <TextView
                android:id="@+id/la_valor_b"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginBottom="5dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="15sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/athos_la_texto"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/la_b_menos"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/athos_la_pilula"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/la_b_mais"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/athos_la_pilula"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/la_ok"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:background="@drawable/athos_la_ok">

            <ImageView
                android:id="@+id/la_ok_icone"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/athos_la_ic_ok" />
        </FrameLayout>
    </LinearLayout>

    <!-- formato 2: série por tempo (prancha): anel + texto + ação -->
    <LinearLayout
        android:id="@+id/la_bloco_tempo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <ProgressBar
                android:id="@+id/la_anel"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="1000"
                android:progressDrawable="@drawable/athos_la_anel_lima" />

            <ProgressBar
                android:id="@+id/la_anel_preparo"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="1000"
                android:progressDrawable="@drawable/athos_la_anel_preparo"
                android:visibility="gone" />

            <TextView
                android:id="@+id/la_anel_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/athos_la_texto"
                android:textSize="19sp" />

            <Chronometer
                android:id="@+id/la_anel_relogio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/athos_la_texto"
                android:textSize="17sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/la_tempo_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/athos_la_texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/la_tempo_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/athos_la_texto_baixo"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/la_ajustes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/la_seg_menos"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/athos_la_ajuste"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="−5s"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/la_seg_mais"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/athos_la_ajuste"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="+5s"
                    android:textColor="@color/athos_la_texto"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la_acao"
            android:layout_width="104dp"
            android:layout_height="76dp"
            android:background="@drawable/athos_la_botao_lima_alto"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/la_acao_icone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/athos_la_ic_play" />

            <TextView
                android:id="@+id/la_acao_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/athos_la_escuro"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- prancha correndo / pausada: dois botões (Pausar|Retomar + Concluir) -->
        <LinearLayout
            android:id="@+id/la_acoes_duplas"
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/la_acao_a"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="@drawable/athos_la_botao_neutro_alto"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/la_acao_a_icone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/la_acao_a_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/la_acao_b"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/athos_la_botao_neutro_alto"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/la_acao_b_icone"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/la_acao_b_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- treino concluído: selo + resumo + salvar no app -->
    <LinearLayout
        android:id="@+id/la_bloco_feito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/athos_la_badge">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/athos_la_ic_ok" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/la_feito_titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/athos_la_texto"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/la_feito_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/athos_la_texto_baixo"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/la_salvar"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:background="@drawable/athos_la_botao_neutro_alto"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/athos_la_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- formato 3: descanso -->
    <LinearLayout
        android:id="@+id/la_bloco_descanso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <Chronometer
                    android:id="@+id/la_desc_relogio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="@color/athos_la_descanso"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/la_desc_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/athos_la_texto_baixo"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/la_mais15"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/athos_la_botao_mais"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="+15s"
                android:textColor="@color/athos_la_texto"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/la_pular"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/athos_la_botao_descanso"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/la_pular_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FF2A1608"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/athos_la_ic_pular" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/la_desc_barra"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="false"
            android:max="1000"
            android:progressDrawable="@drawable/athos_la_barra_descanso" />
    </LinearLayout>
</LinearLayout>

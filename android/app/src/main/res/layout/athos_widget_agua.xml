<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget de hidratação (athoslife-widget-hidratacao.html). A cápsula desce
  18dp dentro do widget pra cabeça do Life "estourar" pra cima sem vazar da
  área do widget (o Android corta o que sai dela).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/wg_capsula"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="18dp"
        android:background="@drawable/athos_wg_capsula"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="70dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/athos_wg_gota" />

                <TextView
                    android:id="@+id/wg_contador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#FFADB3C7"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <ImageView android:id="@+id/wg_copo_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/wg_copo_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/wg_copo_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/wg_copo_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
                <ImageView android:id="@+id/wg_copo_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/athos_wg_divisor" />

        <FrameLayout
            android:id="@+id/wg_camera"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/athos_wg_camera_fundo">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/athos_wg_camera" />
        </FrameLayout>

        <!-- "..." do HTML: widget não abre menu flutuante, então o toque troca
             o volume do copo (250 ml -> 500 ml -> 1 L) e mostra o atual. -->
        <TextView
            android:id="@+id/wg_volume"
            android:layout_width="40dp"
            android:layout_height="38dp"
            android:background="@drawable/athos_wg_mais_fundo"
            android:gravity="center"
            android:lineSpacingMultiplier="0.9"
            android:textColor="#FFF1F3F8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Life: abre o app. Fica por cima da cápsula, estourando pra cima. -->
    <!-- Life animado (life_agua.html do dono, 25/10): widget não roda o motor,
         então são 20 quadros gravados dele (respira e pisca, 3 s em loop) e o
         ViewFlipper troca a cada 150 ms. Um conjunto por faixa da meta. -->
    <ViewFlipper
        android:id="@+id/wg_life"
        android:layout_width="58dp"
        android:layout_height="80dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="8dp"
        android:autoStart="true"
        android:flipInterval="150">
        <ImageView
            android:id="@+id/wg_life_0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_00" />
        <ImageView
            android:id="@+id/wg_life_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_01" />
        <ImageView
            android:id="@+id/wg_life_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_02" />
        <ImageView
            android:id="@+id/wg_life_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_03" />
        <ImageView
            android:id="@+id/wg_life_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_04" />
        <ImageView
            android:id="@+id/wg_life_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_05" />
        <ImageView
            android:id="@+id/wg_life_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_06" />
        <ImageView
            android:id="@+id/wg_life_7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_07" />
        <ImageView
            android:id="@+id/wg_life_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_08" />
        <ImageView
            android:id="@+id/wg_life_9"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_09" />
        <ImageView
            android:id="@+id/wg_life_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_10" />
        <ImageView
            android:id="@+id/wg_life_11"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_11" />
        <ImageView
            android:id="@+id/wg_life_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_12" />
        <ImageView
            android:id="@+id/wg_life_13"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_13" />
        <ImageView
            android:id="@+id/wg_life_14"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_14" />
        <ImageView
            android:id="@+id/wg_life_15"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_15" />
        <ImageView
            android:id="@+id/wg_life_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_16" />
        <ImageView
            android:id="@+id/wg_life_17"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_17" />
        <ImageView
            android:id="@+id/wg_life_18"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_18" />
        <ImageView
            android:id="@+id/wg_life_19"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/athos_wg_life_indo_19" />
    </ViewFlipper>
</FrameLayout>

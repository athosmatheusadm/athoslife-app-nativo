<?xml version="1.0" encoding="utf-8"?>
<!-- Card do mockup: verde-escuro com brilho lima no canto de cima. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/athos_la_fundo" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0" android:centerY="0"
                android:gradientRadius="120%" android:startColor="#22C6FF3D" android:endColor="#00C6FF3D" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cápsula do widget: anel teal (degradê) + face escura por dentro (widget HTML). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF11574E" android:centerColor="#FF062C28" android:endColor="#FF041A18" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="220dp" android:centerX="0.5" android:centerY="0.4" android:startColor="#FF08181A" android:endColor="#FF040C0D" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:bottom="7dp" android:left="7dp" android:right="7dp" android:top="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="#8C21E6A6" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</layer-list>
